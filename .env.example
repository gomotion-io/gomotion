# Copy this file to .env and fill in the values: cp .env.example .env

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: bypasses Row Level Security, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for auth redirects (defaults to http://localhost:3000/)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LemonSqueezy (payments)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Signing secret of the webhook pointing to /api/lemonsqueezy/webhook
LEMONSQUEEZY_SIGNATURE_SECRET=

# Mixpanel (analytics)
NEXT_PUBLIC_MIXPANEL_TOKEN=
